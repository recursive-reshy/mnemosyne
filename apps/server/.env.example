# Port the API listens on
PORT=3100
# Base URL of whisper-server (use http://host.docker.internal:8178 in Docker)
WHISPER_URL=http://localhost:8178
# Where audio lives during a job; defaults to <OS temp dir>/mnemosyne when unset
WORK_DIR=
# Where the SQLite database lives; defaults to <OS temp dir>/mnemosyne-data when unset 
DATA_DIR=
# Model label stored on each transcript; whisper-server does not report it
WHISPER_MODEL=large-v3-turbo
# Folder with the built web app; leave empty in development (Vite serves it)
WEB_DIR=
# Claude API key used to summarize transcripts (required; keep it in .env only)
ANTHROPIC_API_KEY=
# How long one summary request may take, in milliseconds
SUMMARY_TIMEOUT_MS=300000
# Minutes between sweeps that delete expired jobs
CLEANUP_INTERVAL_MINUTES=15
# Hours a job waits in review (or failed summary) before it is deleted
REVIEW_TTL_HOURS=24
# Folder of the Obsidian vault; notes are saved to <VAULT_PATH>/Mnemosyne (required; /vault in Docker)
VAULT_PATH=
