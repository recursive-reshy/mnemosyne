{
  "name": "@mnemosyne/server",
  "version": "0.4.0",
  "private": true,
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "default": "./dist/src/*"
    }
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "dev": "tsx watch --conditions=development --env-file-if-exists=.env src/server.ts",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@mnemosyne/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
