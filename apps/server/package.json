{
  "name": "@mnemosyne/server",
  "version": "0.8.0",
  "private": true,
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "default": "./dist/src/*"
    }
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "dev": "tsx watch --conditions=development --env-file-if-exists=.env src/server.ts | pino-pretty",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fixture:gmail": "tsx --conditions=development --env-file-if-exists=.env scripts/save-gmail-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@googleapis/gmail": "22.0.2",
    "@mnemosyne/shared": "workspace:*",
    "@mozilla/readability": "0.6.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "feedsmith": "3.0.1",
    "linkedom": "0.18.13",
    "pino": "^10.4.0",
    "ts-fsrs": "^5.4.2",
    "turndown": "7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "5.0.6",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
