# Copy to .env (never commit it). Read by docker compose.

# Claude API key used to summarize transcripts (required)
ANTHROPIC_API_KEY=
# Absolute path of your Obsidian vault on this Mac; mounted at /vault (required)
VAULT_HOST_PATH=
# Model label stored on each transcript; must match the model whisper-server runs
WHISPER_MODEL=large-v3-turbo
