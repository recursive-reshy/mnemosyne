# Copy to .env (never commit it). Read by docker compose.
# For development without Docker, use apps/server/.env instead.

# --- Required ---

# Claude API key used to summarize transcripts and articles
ANTHROPIC_API_KEY=
# Absolute path of your Obsidian vault on this Mac; mounted at /vault
VAULT_HOST_PATH=
# Shared secret between the app and the vault agent service (at least 32 characters): openssl rand -hex 32
AGENT_SECRET=
# Absolute path of the folder backups are written to on this Mac, e.g. /Users/<you>/mnemosyne-backups
BACKUP_HOST_PATH=

# --- Optional ---

# Model label stored on each transcript; must match the model whisper-server runs
WHISPER_MODEL=large-v3-turbo
# Vault folder new notes go to unless you pick another; created at startup (default: Mnemosyne)
# DEFAULT_NOTE_FOLDER=
# How much the app and the agent log: fatal, error, warn, info, debug, trace or silent (default: info)
# LOG_LEVEL=info
# How long one linking request to the agent may take, in milliseconds (default: 120000)
# AGENT_TIMEOUT_MS=120000
# Minutes between background checks of the agent service and whisper-server (default: 2)
# STATUS_CHECK_INTERVAL_MINUTES=2

# --- Gmail (optional) ---
# Gmail stays off unless the client ID, secret and key are all set.
# See "Google Cloud setup for Gmail" in the README.

# Client ID and secret of the Google "Web application" OAuth client
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Encrypts the stored Gmail refresh token: 32 bytes in base64, from `openssl rand -base64 32`
# TOKEN_ENCRYPTION_KEY=
# Where Google sends you back after consent (default: http://localhost:3100/api/gmail/oauth/callback)
# GOOGLE_REDIRECT_URI=
