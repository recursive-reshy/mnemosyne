# Copy to .env (never commit it). Read by docker compose.

# Claude API key used to summarize transcripts (required)
ANTHROPIC_API_KEY=
# Absolute path of your Obsidian vault on this Mac; mounted at /vault (required)
VAULT_HOST_PATH=
# Model label stored on each transcript; must match the model whisper-server runs
WHISPER_MODEL=large-v3-turbo
# Vault folder new notes go to unless you pick another; created at startup (default: Mnemosyne)
# DEFAULT_NOTE_FOLDER=

# Gmail (optional, v0.6.0). Gmail stays off unless the client ID, secret and key are all set.
# OAuth "Web application" client from Google Cloud (see the README)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Where Google sends you back after consent (default: http://localhost:<PORT>/api/gmail/oauth/callback)
# GOOGLE_REDIRECT_URI=
# Encrypts the stored Gmail refresh token: 32 bytes in base64, from `openssl rand -base64 32`
# TOKEN_ENCRYPTION_KEY=
