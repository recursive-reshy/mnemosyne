# Copy to .env (never commit it). Read by docker compose.
# For development without Docker, use apps/server/.env instead.

# --- Required ---

# Claude API key used to summarize transcripts and articles
ANTHROPIC_API_KEY=
# Absolute path of the folder on this Mac that holds the vaults (one folder per person); mounted at /vaults
VAULTS_HOST_PATH=
# Shared secret between the app and the vault agent service (at least 32 characters): openssl rand -hex 32
AGENT_SECRET=
# The Google account that becomes the admin on the first sign-in
ADMIN_EMAIL=
# Addresses the app is served at, comma-separated, no path: the local one and the Tailscale one
APP_ORIGINS=http://localhost:3100
# Client ID and secret of the Google "Web application" OAuth client (sign-in and Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored Gmail refresh token and signs the sign-in cookie: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Absolute path of the folder backups are written to on this Mac, e.g. /Users/<you>/mnemosyne-backups
BACKUP_HOST_PATH=

# --- Optional ---

# Model label stored on each transcript; must match the model whisper-server runs
WHISPER_MODEL=large-v3-turbo
# Vault folder new notes go to unless you pick another; created at startup (default: Mnemosyne)
# DEFAULT_NOTE_FOLDER=
# How much the app and the agent log: fatal, error, warn, info, debug, trace or silent (default: info)
# LOG_LEVEL=info
# How long one linking request to the agent may take, in milliseconds (default: 120000)
# AGENT_TIMEOUT_MS=120000
# Minutes between background checks of the agent service and whisper-server (default: 2)
# STATUS_CHECK_INTERVAL_MINUTES=2

# --- Melete (optional) ---

# Time zone for Melete's day boundary (IANA name; default: Asia/Singapore)
# APP_TIME_ZONE=Asia/Singapore
# Hour (0-23) the Melete day starts, so late-night reviews count toward the day before (default: 4)
# MELETE_DAY_START_HOUR=4
# Share of reviewed questions you aim to remember, above 0.7 up to 0.99 (default: 0.9)
# MELETE_REQUEST_RETENTION=0.9
# How long grading one answer may take, in milliseconds (default: 20000)
# MELETE_GRADING_TIMEOUT_MS=20000
# How long generating questions for one note may take, in milliseconds (default: 120000)
# MELETE_GENERATION_TIMEOUT_MS=120000

# --- Sign-in (optional) ---

# Days a sign-in lasts without use (default: 30)
# SESSION_DAYS=30
